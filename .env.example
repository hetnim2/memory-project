# ---------- 앱 실행 ----------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_HOSTS=*

# 배포할 때는 아래 값을 32자 이상의 새 난수로 반드시 교체하세요.
SESSION_SECRET=여기에_긴_임의_문자열_입력
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE_SECONDS=28800

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=memory_user
MYSQL_PASSWORD=여기에_실제_비밀번호_입력
MYSQL_DATABASE=memory_book
MYSQL_POOL_SIZE=5
MYSQL_CONNECT_TIMEOUT=10

# 외부 MySQL이 CA 인증서를 제공할 때만 경로를 입력합니다.
# 예: certificates/ca.pem 또는 Render의 /etc/secrets/ca.pem
MYSQL_SSL_CA=
